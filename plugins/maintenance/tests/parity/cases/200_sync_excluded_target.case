# sync: -Targets ".env" (除外対象) → エラー
ID="mt_sync_excluded_target"
SCRIPT_PS_REL="plugins/maintenance/skills/sync-settings/references/scripts/sync/sync.ps1"
SCRIPT_BASH_REL="plugins/maintenance/skills/sync-settings/references/scripts/sync/sync.sh"
ARGS=("-Repo" "https://github.com/u/r" "-Branch" "main" "-Targets" ".env")
STDIN_FILE=""
ENV_VARS=("USERPROFILE=__SANDBOX__" "HOME=__SANDBOX__")
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths" "ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="false"
COMPARE_EXIT="true"
