# cleanup-config: --Reset を --Yes なしで実行 → エラー
# 備考: PowerShell 側は `-Reset` を `-SetScope` プレフィクス曖昧性で
# 解析誤動作するため (`-Reset` を `-Set` + 値 'eset' と誤分解)、
# Bash 側のみを検証する。SKIP_PS により PowerShell 比較を省略。
ID="mt_cleanup_config_reset_without_yes"
SCRIPT_PS_REL="plugins/maintenance/skills/cleanup-workspace/references/scripts/cleanup/cleanup-config.ps1"
SCRIPT_BASH_REL="plugins/maintenance/skills/cleanup-workspace/references/scripts/cleanup/cleanup-config.sh"
ARGS=("-Reset")
STDIN_FILE=""
ENV_VARS=("USERPROFILE=__SANDBOX__" "HOME=__SANDBOX__")
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths" "ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="false"
COMPARE_EXIT="true"
SKIP_PS="ps_param_prefix_ambiguity"
