# cleanup: .claude/.local/work/ が存在しない → "対象ルートが見つかりませんでした"
# (Scope=global で、project スコープ git toplevel も sandbox 内には .claude/.local/work がない)
ID="mt_cleanup_no_work_dir"
SCRIPT_PS_REL="plugins/maintenance/skills/cleanup-workspace/references/scripts/cleanup/cleanup.ps1"
SCRIPT_BASH_REL="plugins/maintenance/skills/cleanup-workspace/references/scripts/cleanup/cleanup.sh"
ARGS=("-Days" "30" "-Scope" "global" "-DryRun")
STDIN_FILE=""
ENV_VARS=("USERPROFILE=__SANDBOX__" "HOME=__SANDBOX__")
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths" "ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="false"
COMPARE_EXIT="true"
