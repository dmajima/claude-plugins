# sync: -Branch "feature/../etc" (不正、パストラバーサル) → エラー
# 備考: 元々 "/leading" を試したかったが、MSYS が `/leading` を Windows パスに変換してしまうため、
# パス変換の影響を受けない "feature/../etc" で代替検証 (パス '..' 検出ルールで reject される)。
ID="mt_sync_unsafe_branch"
SCRIPT_PS_REL="plugins/maintenance/skills/sync-settings/references/scripts/sync/sync.ps1"
SCRIPT_BASH_REL="plugins/maintenance/skills/sync-settings/references/scripts/sync/sync.sh"
ARGS=("-Repo" "https://github.com/u/r" "-Branch" "feature/../etc")
STDIN_FILE=""
ENV_VARS=("USERPROFILE=__SANDBOX__" "HOME=__SANDBOX__")
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths" "ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="false"
COMPARE_EXIT="true"
