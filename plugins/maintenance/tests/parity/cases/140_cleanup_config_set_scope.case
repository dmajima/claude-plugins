# cleanup-config: --SetScope global で値変更
ID="mt_cleanup_config_set_scope"
SCRIPT_PS_REL="plugins/maintenance/skills/cleanup-workspace/references/scripts/cleanup/cleanup-config.ps1"
SCRIPT_BASH_REL="plugins/maintenance/skills/cleanup-workspace/references/scripts/cleanup/cleanup-config.sh"
ARGS=("-SetScope" "global")
STDIN_FILE=""
ENV_VARS=("USERPROFILE=__SANDBOX__" "HOME=__SANDBOX__")
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths" "ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="false"
COMPARE_EXIT="true"
