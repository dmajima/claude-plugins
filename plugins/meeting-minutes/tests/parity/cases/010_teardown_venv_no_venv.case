# teardown_venv が存在しない venv ディレクトリを指された場合の挙動。
# meeting-minutes 版の出力: "[teardown_venv] No venv found at: <path>" / exit 0
ID="mm_teardown_venv_no_venv"
SCRIPT_PS_REL="plugins/meeting-minutes/references/scripts/setup/teardown_venv.ps1"
SCRIPT_BASH_REL="plugins/meeting-minutes/references/scripts/setup/teardown_venv.sh"
ARGS_PS=("-WorkDir" "__SANDBOX__/workspace")
ARGS_BASH=("__SANDBOX__/workspace")
STDIN_FILE=""
ENV_VARS=()
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="false"
COMPARE_EXIT="true"
