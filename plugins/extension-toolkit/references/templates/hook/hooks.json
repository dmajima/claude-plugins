{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "{tool-name-pattern}",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/references/scripts/hooks/{script-name}.sh\"",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [],
    "UserPromptSubmit": [],
    "Stop": [],
    "SessionStart": []
  }
}
