{
  "schema_version": 1,
  "weights": {
    "keyword_overlap": 1.0,
    "trigger_phrase": 2.0,
    "eval_similarity": 3.0,
    "context_continuity": 1.5,
    "file_ext_match": 2.0,
    "skip_phrase_combo": -5.0,
    "skip_phrase_single": -1.0
  },
  "thresholds": {
    "high_score": 8.0,
    "high_ratio": 1.25,
    "mid_score": 4.0
  },
  "candidate_filter": {
    "max_candidates_per_route": 50,
    "max_postings_per_keyword": 50,
    "context_window": 3
  },
  "tokenizer": {
    "min_kanji_length": 2,
    "min_katakana_length": 4
  }
}
