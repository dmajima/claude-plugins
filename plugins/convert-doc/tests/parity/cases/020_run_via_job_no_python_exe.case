# run_via_job: PythonExe 未指定（環境変数も無）の挙動。
# 期待: stderr に "PythonExe not found." 系メッセージ / exit 2
# 注: PowerShell 版は Write-Error 装飾が付くため stderr 比較は ps_error_decoration で吸収。
ID="run_via_job_no_python_exe"
SCRIPT_PS_REL="plugins/convert-doc/references/scripts/convert-from-pptx/run_via_job.ps1"
SCRIPT_BASH_REL="plugins/convert-doc/references/scripts/convert-from-pptx/run_via_job.sh"
ARGS_PS=("-InputPath" "input.pptx" "-OutputPath" "output.md")
ARGS_BASH=("input.pptx" "output.md")
STDIN_FILE=""
ENV_VARS=()
PRE_FS=""
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths")
NORMALIZE_STDERR=("ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="false"
COMPARE_FS="false"
COMPARE_EXIT="true"
