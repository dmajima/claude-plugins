# teardown_venv が既存 venv ディレクトリ（dummy）を削除する挙動。
# 期待: stdout に "[OK] Removing venv at <path>" + "[DONE] venv removed" / exit 0
ID="teardown_venv_with_dummy"
SCRIPT_PS_REL="plugins/convert-doc/references/scripts/setup/teardown_venv.ps1"
SCRIPT_BASH_REL="plugins/convert-doc/references/scripts/setup/teardown_venv.sh"
ARGS_PS=("-WorkDir" "__SANDBOX__/workspace")
ARGS_BASH=("__SANDBOX__/workspace")
STDIN_FILE=""
ENV_VARS=()
PRE_FS="plugins/convert-doc/tests/parity/fixtures/with_dummy_venv"
POST_FS_INCLUDE=("workspace")
NORMALIZE=("crlf" "abs_paths")
COMPARE_STDOUT="true"
COMPARE_STDERR="true"
COMPARE_FS="true"
COMPARE_EXIT="true"
