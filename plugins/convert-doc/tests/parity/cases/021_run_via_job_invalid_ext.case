# run_via_job: PythonExe が .exe 拡張子でない場合の SEC-M2 検証。
# fixtures/with_fake_exe/ に non-.exe ファイル (fake.bat) を配置して、それを PythonExe として指定。
# 期待: exit 2、stderr に ".exe file" 系メッセージ
ID="run_via_job_invalid_ext"
SCRIPT_PS_REL="plugins/convert-doc/references/scripts/convert-from-pptx/run_via_job.ps1"
SCRIPT_BASH_REL="plugins/convert-doc/references/scripts/convert-from-pptx/run_via_job.sh"
ARGS_PS=("-InputPath" "input.pptx" "-OutputPath" "output.md" "-PythonExe" "__SANDBOX__/fake.bat")
ARGS_BASH=("input.pptx" "output.md" "-PythonExe" "__SANDBOX__/fake.bat")
STDIN_FILE=""
ENV_VARS=()
PRE_FS="plugins/convert-doc/tests/parity/fixtures/with_fake_exe"
POST_FS_INCLUDE=()
NORMALIZE=("crlf" "abs_paths")
NORMALIZE_STDERR=("ps_error_decoration")
COMPARE_STDOUT="true"
COMPARE_STDERR="false"
COMPARE_FS="false"
COMPARE_EXIT="true"
