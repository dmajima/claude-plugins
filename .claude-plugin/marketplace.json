      "category": "security",
      "source": "./plugins/credentials-manager",
      "author": {
        "name": "dmajima"
      },
      "keywords": [
        "credentials",
        "secrets",
        "api-key",
        "token",
        "auth",
        "url-match",
        "auto-apply",
