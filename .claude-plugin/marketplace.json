        "rule-template",
        "session-start",
        "pre-tool-use",
        "credentials-reader",
        "credentials-manager",
        "manage-command",
        "interactive-ui"
      ]
    },
    {
      "name": "extension-toolkit",
      "source": "./plugins/extension-toolkit",
      "description": "Claude Code 拡張要素（プラグイン/スキル/コマンド/エージェント/フック）の作成・レビュー・公開を統括支援",
      "category": "developer-tools",
      "author": {
        "name": "dmajima"
      },
