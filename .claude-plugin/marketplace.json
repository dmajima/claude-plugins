{
  "name": "dmajima-claude-plugins",
  "owner": {
    "name": "dmajima"
  },
  "description": "dmajima 個人用 Claude Code プラグインマーケットプレイス",
  "allowCrossMarketplaceDependenciesOn": ["anthropic-agent-skills"],
  "plugins": [
    {
      "name": "credentials-manager",
      "description": "認証情報の参照(reader)/管理(manager)/対話UI(/manage)を分離した責務特化型セキュリティプラグイン",
      "category": "security",
      "source": "./plugins/credentials-manager",
      "author": {
        "name": "dmajima"
      },
      "keywords": [
        "credentials",
        "secrets",
        "api-key",
        "token",
        "auth",
        "url-match",
        "auto-apply",
        "hooks",
        "rule-template",
        "session-start",
        "pre-tool-use",
        "credentials-reader",
        "credentials-manager",
        "manage-command",
        "interactive-ui"
      ]
    },
    {
      "name": "extension-toolkit",
      "source": "./plugins/extension-toolkit",
      "description": "Claude Code 拡張要素（プラグイン/スキル/コマンド/エージェント/フック）の作成・レビュー・公開を統括支援",
      "category": "developer-tools",
      "author": {
        "name": "dmajima"
      },
      "keywords": [
        "skill-toolkit",
        "plugin-toolkit",
        "command-toolkit",
        "agent-toolkit",
        "hook-toolkit",
        "readme-toolkit",
        "environment-setup-toolkit",
        "marketplace-toolkit",
        "mit-license-toolkit",
        "extension-reviewer",
        "marketplace-publisher",
        "scaffolding"
      ]
    },
    {
      "name": "plugins-update",
      "source": "./plugins/plugins-update",
      "description": "インストール済みマーケットプレイス・プラグインを公式 CLI で一括最新化する",
      "category": "maintenance",
      "author": {
        "name": "dmajima"
      },
      "keywords": [
        "plugin",
        "update",
        "marketplace",
        "maintenance",
        "auto-update",
        "command",
        "cli"
      ]
    },
    {
      "name": "convert-doc",
      "source": "./plugins/convert-doc",
      "description": "Markdown を Wiki スタイルの HTML / PDF / PPTX に一括変換するドキュメント変換プラグイン",
      "author": {
        "name": "dmajima"
      },
      "category": "documentation",
      "keywords": [
        "markdown",
        "html",
        "pdf",
        "pptx",
        "powerpoint",
        "conversion",
        "documentation",
        "mermaid",
        "wiki"
      ],
      "strict": false
    },
    {
      "name": "skill-router",
      "source": "./plugins/skill-router",
      "description": "ユーザプロンプトに応じた最適スキルを UserPromptSubmit フックで自動推奨し、スキル起動率を高めるプラグイン",
      "author": {
        "name": "dmajima"
      },
      "category": "productivity",
      "keywords": [
        "skill-router",
        "router",
        "user-prompt-submit",
        "session-start",
        "skill-invocation",
        "additional-context",
        "hooks"
      ]
    },
    {
      "name": "session-usage",
      "source": "./plugins/session-usage",
      "description": "カレントセッションのトークン消費量を JSONL から直接集計し、対話 TUI（フルスクリーン + キー入力受付）でクリップボードコピー可能に表示するプラグイン",
      "author": {
        "name": "dmajima"
      },
      "category": "diagnostics",
      "keywords": [
        "session",
        "usage",
        "tokens",
        "diagnostics",
        "tui",
        "clipboard",
        "powershell",
        "interactive",
        "doctor-like"
      ]
    }
  ]
}
