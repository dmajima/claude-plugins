{
  "name": "dmajima-claude-plugins",
  "owner": {
    "name": "dmajima"
  },
  "description": "dmajima 個人用 Claude Code プラグインマーケットプレイス",
  "allowCrossMarketplaceDependenciesOn": ["anthropic-agent-skills"],
  "plugins": [
    {
      "name": "credentials-manager",
      "description": "認証情報を保存・自動適用 + フックで認証情報を扱う全パスを最優先化するセキュリティプラグイン",
      "category": "security",
      "source": "./plugins/credentials-manager",
      "author": {
        "name": "dmajima"
      },
      "keywords": [
        "credentials",
        "secrets",
        "api-key",
        "token",
        "auth",
        "url-match",
        "auto-apply",
        "hooks",
        "rule-template",
        "session-start",
        "pre-tool-use"
      ]
    },
    {
      "name": "extension-toolkit",
      "source": "./plugins/extension-toolkit",
      "description": "Claude Code 拡張要素（プラグイン/スキル/コマンド/エージェント/フック・README）の作成・レビュー・マーケットプレイス公開まで統括支援"
    },
    {
      "name": "plugins-update",
      "source": "./plugins/plugins-update",
      "description": "インストール済みマーケットプレイス・プラグインを公式 CLI で一括最新化する",
      "category": "maintenance",
      "author": {
        "name": "dmajima"
      },
      "keywords": [
        "plugin",
        "update",
        "marketplace",
        "maintenance",
        "auto-update",
        "command",
        "cli"
      ]
    },
    {
      "name": "convert-doc",
      "source": "./plugins/convert-doc",
      "description": "Markdown を Wiki スタイルの HTML / PDF / PPTX に一括変換するドキュメント変換プラグイン",
      "author": {
        "name": "dmajima"
      },
      "category": "documentation",
      "keywords": [
        "markdown",
        "html",
        "pdf",
        "pptx",
        "powerpoint",
        "conversion",
        "documentation",
        "mermaid",
        "wiki"
      ],
      "strict": false
    },
    {
      "name": "skill-router",
      "source": "./plugins/skill-router",
      "description": "ユーザプロンプトに応じた最適スキルを UserPromptSubmit フックで自動推奨し、スキル起動率を高めるプラグイン",
      "author": {
        "name": "dmajima"
      },
      "category": "productivity",
      "keywords": [
        "skill-router",
        "router",
        "user-prompt-submit",
        "session-start",
        "skill-invocation",
        "additional-context",
        "hooks"
      ]
    }
  ]
}
